---
import Base from '../layouts/Base.astro';
import { evaluacion, harness, nombre, reglas, telemetria } from '../lib/cerebro.mjs';
const pct = (x) => (x == null ? '—' : Math.round(x * 100) + '%');
const activas = harness.piezas.filter((p) => p.activo).length;
const ORIGEN = { 'mcp': 'el agente preguntó (MCP)', 'hook:prompt': 'inyectadas en el prompt', 'hook:editar': 'vigiladas al editar',
                 'hook:commit': 'commits parados', 'hook:parar': 'paradas al terminar' };
const nombreRegla = (id) => reglas.find((r) => r.id === id)?.titulo || '';
---
<Base title="Harness" subtitle="Lo que el plugin hace solo, y cómo se sabe si funciona" active="harness">
  <div class="kpis">
    <div class="kpi"><div class="n">{activas}<span style="font-size:16px;color:var(--faint)">/{harness.piezas.length}</span></div><div class="k">Hooks activos en este cerebro</div></div>
    <div class="kpi"><div class="n">{evaluacion.casos ? pct(evaluacion.recall) : '—'}</div><div class="k">Recall del enrutado · {evaluacion.casos} consultas evaluadas</div>
      {evaluacion.casos > 0 && <div class="bar"><i style={`width:${Math.round(evaluacion.recall * 100)}%;background:${evaluacion.pasa ? 'var(--ink-2)' : '#e34948'}`}></i></div>}</div>
    <div class="kpi"><div class="n">{evaluacion.casos ? pct(evaluacion.precision) : '—'}</div><div class="k">Precisión del enrutado</div></div>
    <div class="kpi"><div class="n">{telemetria.consultas}</div><div class="k">Consultas registradas · {telemetria.tasa_acierto == null ? 'sin datos' : pct(telemetria.tasa_acierto) + ' con resultado'}</div></div>
    <div class="kpi"><div class="n">{telemetria.hallazgos}</div><div class="k">Hallazgos devueltos al agente · {telemetria.bloqueos} bloqueos</div></div>
  </div>

  <div class="sec-title">Los cinco hooks</div>
  <table class="dtable">
    <thead><tr><th style="width:150px">Evento</th><th style="width:210px">Qué hace</th><th></th><th style="width:110px">Aquí</th></tr></thead>
    <tbody>
      {harness.piezas.map((p) => (
        <tr>
          <td class="id">{p.evento}</td>
          <td><b>{p.nombre}</b></td>
          <td style="color:var(--ink-2)">{p.que}{p.clave && <> <code style="color:var(--faint)">harness.{p.clave}</code></>}</td>
          <td>{p.activo ? <span class="chip"><span class="gl">✓</span> activo</span> : <span class="chip"><span class="gl">·</span> apagado</span>}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="lead" style="margin-top:10px;font-size:12.5px;color:var(--faint)"><code>hooks/hooks.json</code> · <code>motor/harness.py</code> · se apagan en <code>kumiko.json → harness</code></p>

  <div class="sec-title">¿Acierta el enrutado? · <code>{harness.evaluaciones}</code></div>
  {evaluacion.casos === 0 ? (
    <p class="lead">Sin conjunto de evaluación todavía: <code>{"{"}"consulta": "…", "esperadas": ["ID-1"]{"}"}</code>, una por línea.</p>
  ) : (
    <>
      <p class="lead" style="font-size:12.5px;color:var(--faint)"><code>motor/evaluar.py</code> · umbral de recall {pct(evaluacion.umbral_recall)}</p>
      <table class="dtable">
        <thead><tr><th style="width:36px"></th><th>Consulta</th><th style="width:220px">Esperadas</th><th style="width:260px">Salieron</th></tr></thead>
        <tbody>
          {evaluacion.filas.map((f) => (
            <tr>
              <td>{f.ok ? <span class="chip"><span class="gl">✓</span></span> : <span class="chip" style="color:#e34948"><span class="gl">✗</span></span>}</td>
              <td>«{f.consulta}»{f.faltan.length > 0 && <div class="ref" style="color:#e34948;margin-top:4px">faltan: {f.faltan.join(', ')}</div>}{f.indebidas.length > 0 && <div class="ref" style="color:#e34948;margin-top:4px">indebidas: {f.indebidas.join(', ')}</div>}</td>
              <td class="ref">{f.esperadas.join(', ') || '(nada)'}</td>
              <td class="ref">{f.salieron.join(', ') || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <div class="sec-title">Qué se consulta de verdad · <code>{harness.telemetria}</code></div>
  {telemetria.eventos === 0 ? (
    <p class="lead">Sin actividad todavía.</p>
  ) : (
    <>
      <div class="cards" style="grid-template-columns:repeat(auto-fill,minmax(285px,1fr))">
        <div class="card">
          <div class="h"><span class="t">Por dónde llegan</span></div>
          <table class="dtable" style="margin-top:8px">
            <tbody>{Object.entries(telemetria.por_origen).map(([k, v]) => (
              <tr><td>{ORIGEN[k] || k}</td><td class="ref" style="text-align:right">{v}</td></tr>))}</tbody>
          </table>
        </div>
        <div class="card">
          <div class="h"><span class="t">Reglas más devueltas</span></div>
          <table class="dtable" style="margin-top:8px">
            <tbody>{telemetria.reglas_mas_devueltas.length === 0 ? <tr><td style="color:var(--faint)">todavía ninguna</td></tr>
              : telemetria.reglas_mas_devueltas.map((x) => (
              <tr><td class="id">{x.regla}</td><td style="color:var(--ink-2)">{nombreRegla(x.regla)}</td><td class="ref" style="text-align:right">{x.veces}</td></tr>))}</tbody>
          </table>
        </div>
        <div class="card">
          <div class="h"><span class="t">Reglas que paran errores</span></div>
          <table class="dtable" style="margin-top:8px">
            <tbody>{telemetria.reglas_con_hallazgos.length === 0 ? <tr><td style="color:var(--faint)">todavía ninguna</td></tr>
              : telemetria.reglas_con_hallazgos.map((x) => (
              <tr><td class="id">{x.regla}</td><td style="color:var(--ink-2)">{nombreRegla(x.regla)}</td><td class="ref" style="text-align:right">{x.veces}</td></tr>))}</tbody>
          </table>
        </div>
      </div>

      <div class="sec-title">Consultas sin resultado · el trabajo pendiente</div>
      {telemetria.ultimas_sin_resultado.length === 0 ? (
        <p class="lead">Ninguna.</p>
      ) : (
        <>
          <table class="dtable">
            <thead><tr><th style="width:170px">Cuándo</th><th>Consulta</th><th style="width:200px">Origen</th></tr></thead>
            <tbody>{telemetria.ultimas_sin_resultado.map((x) => (
              <tr><td class="ref">{x.ts.replace('T', ' ')}</td><td>«{x.consulta}»</td><td style="color:var(--ink-2)">{ORIGEN[x.origen] || x.origen}</td></tr>))}</tbody>
          </table>
        </>
      )}
      <p class="lead" style="margin-top:12px;color:var(--faint)">Registrado entre {telemetria.desde.replace('T', ' ')} y {telemetria.hasta.replace('T', ' ')}.</p>
    </>
  )}
</Base>
