---
// La marca del visor. Por defecto, el logo de Fusuma, que es quien hace kumiko.
// Un cerebro puede poner el suyo con "marca": { "logo": "ruta/al.svg" } en su
// kumiko.json (ruta relativa a la raíz del cerebro); el SVG hereda el color del
// texto con `currentColor`, así funciona igual sobre papel y sobre tinta.
import fs from 'node:fs';
import path from 'node:path';
import { RAIZ, marca } from '../lib/cerebro.mjs';
import fusuma from '../assets/fusuma-logo.svg?raw';

const { size = 30 } = Astro.props;
let svg = fusuma;
let ancho = size * 3.8;             // el logo de Fusuma es apaisado (252×104)
if (marca.logo) {
  const p = path.join(RAIZ, marca.logo);
  if (fs.existsSync(p)) { svg = fs.readFileSync(p, 'utf8'); ancho = size * 3.4; }
}
---
<span class="logo" style={`display:block;width:${ancho}px`} set:html={svg} />
<style>.logo :global(svg) { width: 100%; height: auto; display: block; }</style>
